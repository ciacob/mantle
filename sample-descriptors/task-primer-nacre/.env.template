# task-primer-nacre/.env.template
#
# Copy this file to .env and fill in your values.
# Add .env to .gitignore — it contains machine-specific and potentially
# sensitive values.
#
# Variables already set in the shell environment take precedence over values
# here. Leave sensitive values (APPLE_PASSWORD) blank and set them in the
# shell or CI instead.
#
# Required variables are marked [REQUIRED] — the build will fail fast if they
# are empty after resolution from .env + shell environment.

# ── Source project ────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the root of the task-primer project to package.
SOURCE_DIR=

# ── Application identity ──────────────────────────────────────────────────────

# [REQUIRED] Human-readable application name (used for the .app bundle name,
# menu bar, and Dock label).
APP_NAME=

# [REQUIRED] Reverse-DNS bundle identifier (e.g. com.example.myapp).
# Must match taskPrimer.appBundleId in the project's package.json.
APP_BUNDLE_ID=

# [REQUIRED] Application version string (e.g. 1.0.0).
APP_VERSION=

# [REQUIRED] Path to an .icns icon file.
# Absolute paths are used as-is. Relative paths are resolved against this
# descriptor's assets/ folder — so you can drop the .icns there and just
# write the filename (e.g. APP_ICON=MyApp.icns).
APP_ICON=

# ── Build output ──────────────────────────────────────────────────────────────

# [REQUIRED] Directory where the final .app bundle is written.
OUTPUT_DIR=./dist

# ── nacre ─────────────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the nacre repository root.
# The build script calls node scripts/build.js from here.
NACRE_DIR=

# ── pkg ───────────────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the pkg binary (or leave as "pkg" if globally installed).
PKG_BIN=pkg

# Node.js target version for pkg (e.g. node20).
PKG_TARGET=node20-macos-arm64

# ── Code signing ──────────────────────────────────────────────────────────────

# Apple Developer ID identity string for codesign.
# Example: "Developer ID Application: Your Name (TEAMID)"
# Leave blank to skip signing (unsigned builds cannot be notarized).
APPLE_IDENTITY=

# ── Notarization ──────────────────────────────────────────────────────────────
# Leave all three blank to skip notarization.

# Apple ID email address used for notarytool.
APPLE_ID=

# App-specific password for notarytool (set in shell — do not commit).
APPLE_PASSWORD=

# Apple Developer Team ID.
APPLE_TEAM_ID=
