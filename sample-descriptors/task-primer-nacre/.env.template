# task-primer-nacre/.env.template
#
# Copy this file to .env and fill in your values.
# Add .env to .gitignore — it contains machine-specific and potentially
# sensitive values.
#
# Variables already set in the shell environment take precedence over values
# here. Leave sensitive values (APPLE_PASSWORD) blank and set them in the
# shell or CI instead.
#
# Required variables are marked [REQUIRED] — the build will fail fast if they
# are empty after resolution from .env + shell environment.

# ── Source project ────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the root of the task-primer project to package.
SOURCE_DIR=

# ── Application identity ──────────────────────────────────────────────────────

# [REQUIRED] Human-readable application name (used for the .app bundle name,
# menu bar, and Dock label).
APP_NAME=

# [REQUIRED] Reverse-DNS bundle identifier (e.g. com.example.myapp).
# Must match taskPrimer.appBundleId in the project's package.json.
APP_BUNDLE_ID=

# [REQUIRED] Application version string (e.g. 1.0.0).
APP_VERSION=

# [REQUIRED] Path to an .icns icon file.
# Absolute paths are used as-is. Relative paths are resolved against this
# descriptor's assets/ folder — so you can drop the .icns there and just
# write the filename (e.g. APP_ICON=MyApp.icns).
APP_ICON=

# ── Build output ──────────────────────────────────────────────────────────────

# [REQUIRED] Directory where the final .app bundle is written.
OUTPUT_DIR=./dist

# ── nacre ─────────────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the nacre repository root.
# The build script calls node scripts/build.js from here.
NACRE_DIR=

# ── pkg ───────────────────────────────────────────────────────────────────────

# [REQUIRED] Absolute path to the pkg binary (or leave as "pkg" if globally installed).
PKG_BIN=pkg

# Node.js target version for pkg (must match your app's engines.node requirement).
# The first run downloads and compiles the Node base binary (~10 min).
# Subsequent runs use the pkg cache and are fast.
PKG_TARGET=node20-macos-arm64

# ── Code signing ──────────────────────────────────────────────────────────────

# Path to the entitlements .plist file used when signing the Mach-O binary.
# The default file (assets/entitlements.plist) grants the JIT entitlement
# required by V8 (Node.js) under the hardened runtime. Without it the app
# crashes immediately on launch with a virtual memory error.
# Relative values resolve against this descriptor's assets/ folder.
# Override only if your app requires additional or different entitlements.
ENTITLEMENTS_PLIST=entitlements.plist

# Apple Developer ID identity string for codesign.
# This is public information — it appears in every signed binary.
# Find yours: security find-identity -v -p codesigning
# Example: Developer ID Application: Your Name (TEAMID)
# Leave blank to skip signing (unsigned builds cannot be notarized).
APPLE_IDENTITY=

# ── Notarization ──────────────────────────────────────────────────────────────
# Leave all three blank to skip notarization.

# Apple ID email address used for notarytool. Public — safe to store here.
APPLE_ID=

# Apple Developer Team ID. Public — safe to store here.
APPLE_TEAM_ID=

# App-specific password for notarytool.
# This is the ONLY sensitive value in this file.
# Do NOT fill it in here — set it in your shell or CI environment instead:
#   export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
# Generate one at: https://appleid.apple.com → App-Specific Passwords
APPLE_PASSWORD=
